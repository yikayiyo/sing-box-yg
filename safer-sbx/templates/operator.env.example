# 运营商填写（不含 UUID/密钥；密钥由安装器本地生成）
# 复制到 /etc/safer-sbx/operator.env 后编辑（安装器也会在首次安装时复制）

# 本机 VLESS 监听端口（TCP）
LISTEN_PORT=443

# Reality TLS server_name（须为域名，由你自行选择并确认兼容；不要随意冒充无关站点）
# 兼容限制：目标通常需支持 TLS1.3，且 SNI/证书行为与 Reality 握手期望一致。
REALITY_SERVER_NAME=replace-with-your-chosen.example

# Reality 握手目标（通常与 server_name 相同；端口多为 443）
REALITY_HANDSHAKE_SERVER=replace-with-your-chosen.example
REALITY_HANDSHAKE_PORT=443

# 写入本地客户端配置时使用的服务器地址（IP 或你的 DNS 名；可稍后改）
CLIENT_SERVER_ADDRESS=YOUR_SERVER_IP_OR_DNS
