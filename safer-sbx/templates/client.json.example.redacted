{
  "log": { "level": "warn", "timestamp": true },
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "YOUR_SERVER_IP_OR_DNS",
      "server_port": 443,
      "uuid": "REDACTED-UUID",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "replace-with-your-chosen.example",
        "utls": { "enabled": true, "fingerprint": "chrome" },
        "reality": {
          "enabled": true,
          "public_key": "REDACTED-PUBLIC-KEY",
          "short_id": "REDACTED"
        }
      }
    },
    { "type": "direct", "tag": "direct" }
  ]
}
